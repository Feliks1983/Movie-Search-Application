{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "app/components/pagination.tsx",
    "app/components/header.tsx",
    "app/components/search.tsx",
    "app/components/tabs.tsx",
    "app/components/footer.tsx",
    "app/components/content.tsx",
    "app/components/componentContent.tsx",
    "app/components/button.tsx",
    "src/app/ui/componentContent.jsx",
    "src/app/ui/button.jsx",
    "src/app/ui/content.jsx",
    "src/app/ui/footer.jsx",
    "src/app/ui/header.jsx",
    "src/app/ui/pagination.jsx",
    "src/app/ui/search.jsx",
    "src/app/ui/tabs.jsx",
    "src/app/api/move/route.ts",
    "src/app/api/video/route.ts"
  ],
  "exclude": ["node_modules"]
}
